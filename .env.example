# AskTube AI - Example environment variables

# App
APP_ENV=development
DEBUG=true
PORT=8000

# Database (SQLite)
DATABASE_URL=sqlite:///./asktube.db
SQLALCHEMY_DATABASE_URL=sqlite:///./asktube.db

# ChromaDB
CHROMA_DB_DIR=./data/chroma
CHROMA_PERSIST=true

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# LLM / API keys
# Groq API (primary LLM provider)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com

# OpenAI (fallback / optional)
OPENAI_API_KEY=

# Whisper (fallback transcription)
WHISPER_MODEL=small
FFMPEG_PATH=ffmpeg

# YouTube downloader / transcript
YT_TRANSCRIPT_LANGUAGE=en
YTDLP_PATH=yt-dlp

# Application defaults
DEFAULT_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TEMPERATURE=0.0
MAX_TOKENS=1024

# File storage
UPLOAD_DIR=./data/uploads
EMBEDDING_INDEX_DIR=./data/chroma
LOG_DIR=./logs

# Logging
LOG_LEVEL=INFO

# Notes:
# - Fill in GROQ_API_KEY (required) and OPENAI_API_KEY if using OpenAI services.
# - Ensure `ffmpeg` is installed on the system for Whisper audio processing.
# - Adjust CHUNK_SIZE/CHUNK_OVERLAP and DEFAULT_TOP_K in Settings page or via environment.
